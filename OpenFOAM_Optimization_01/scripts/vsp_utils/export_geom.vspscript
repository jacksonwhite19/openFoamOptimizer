void main()
{
    // --- Clear existing model ---
    ClearVSPModel();

    // --- Load baseline geometry and DES file ---
    string vsp_file = "Z:/home/jwhite/JWsim/OpenFOAM_Optimization_01/geometry/source/baseline.vsp3";
    ReadVSPFile(vsp_file);

    string des_file = "Z:/home/jwhite/JWsim/OpenFOAM_Optimization_01/geometry/source/baseline.des";
    ReadApplyDESFile(des_file);

    Update(); // initial update

    // --- Mass Properties ---
    SetAnalysisInputDefaults("MassProp");
    string ridmp = ExecAnalysis("MassProp");
    Update(); // ensure MassProp results are ready

    string massprop_csv = "Z:/home/jwhite/JWsim/OpenFOAM_Optimization_01/geometry/outputs/baseline_massprops.csv";
    WriteResultsCSVFile(ridmp, massprop_csv);

    // --- Degen Geometry ---
    SetAnalysisInputDefaults("DegenGeom");
    string riddeg = ExecAnalysis("DegenGeom");
    Update(); // ensure DegenGeom results are ready

    // Get all DegenGeom result IDs
    array<string> degen_ids = GetStringResults(riddeg, "Degen_DegenGeoms");

    for (int i = 0; i < int(degen_ids.size()); i++)
    {
        string type = GetStringResults(degen_ids[i], "type")[0];

        if (type == "LIFTING_SURFACE")
        {
            string name = GetStringResults(degen_ids[i], "name")[0];

            // Get plates child result ID
            array<string> plates_id = GetStringResults(degen_ids[i], "plates");

            if (plates_id.size() > 0)
            {
                string fname = "Z:/home/jwhite/JWsim/OpenFOAM_Optimization_01/geometry/outputs/degen_" + name + "_plates.csv";
                WriteResultsCSVFile(plates_id[0], fname);
            }
            else
            {
                Print("Warning: No plates result for " + name);
            }
        }
    }

    // --- Clean up ---
    DeleteGeomVec(GetStringResults(ridmp, "Mesh_GeomID"));
}