void main()
{
    ClearVSPModel();

    // Load from source
    string vsp_file = "Z:/home/jwhite/JWsim/OpenFOAM_Optimization_01/geometry/source/baseline.vsp3";
    ReadVSPFile(vsp_file);
    
    string des_file = "Z:/home/jwhite/JWsim/OpenFOAM_Optimization_01/geometry/source/baseline.des";
    ReadApplyDESFile(des_file);
    
    Update();

    // Output to outputs/
    SetAnalysisInputDefaults("MassProp");
    string ridmp = ExecAnalysis("MassProp");
    
    WriteResultsCSVFile(ridmp, 
        "Z:/home/jwhite/JWsim/OpenFOAM_Optimization_01/geometry/outputs/baseline_massprops.csv");
    
    DeleteGeomVec(GetStringResults(ridmp, "Mesh_GeomID"));
}