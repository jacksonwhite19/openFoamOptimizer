  "geometry_sanity_constraints": [
    {
      "id": "all_lengths_positive",
      "type": "hard",
      "rule": "all length variables > 0"
    },
    {
      "id": "taper_ratio_bounds",
      "type": "hard",
      "rule": "all taper ratios in [0.2, 1.2]"
    },
    {
      "id": "wing_aspect_ratio_bounds",
      "type": "hard",
      "rule": "wing_AR in [3.0, 14.0]"
    },
    {
      "id": "wing_area_bounds",
      "type": "hard",
      "rule": "wing_planform_area_m2 in [0.02, 0.5]"
    },
    {
      "id": "te_thickness_min",
      "type": "hard",
      "rule": "trailing_edge_thickness_m >= 5e-4"
    }
  ],
  "objective": {
    "name": "weighted_ld_minus_penalties",
    "maximize": true,
    "formula_text": "score_total = weighted_mean(L/D over alpha sweep) - penalty_total",
    "base_metric": "weighted_ld_mean",
    "secondary_metrics": [
      "weighted_cl_mean",
      "static_margin_percent",
      "cma_slope"
    ]
  },
  "constraints": {
    "accepted_convergence_status": [
      "converged",
      "quasi_steady"
    ],
    "static_margin_percent_min": 5.0,
    "static_margin_percent_max": 15.0,
    "require_negative_cma_slope": true,
    "noise_thresholds": {
      "cl_std_rel_max": 0.02,
      "cd_std_rel_max": 0.02,
      "cm_std_rel_max": 0.03
    }
  },
  "penalties": {
    "missing_alpha_case": 50.0,
    "mesh_warning_per_alpha": 1.5,
    "mesh_failed_check_per_count": 0.5,
    "nonconverged_per_alpha": 2.0,
    "noise_threshold_violation_per_metric": 1.0,
    "static_margin_outside_range_per_percent": 0.4,
    "positive_cma_slope": 8.0
  },
  "evaluation_contract": {
    "output_schema_version": "1.0",
    "required_fields": [
      "objective.score_total",
      "objective.penalty_total",
      "constraints.feasible",
      "status"
    ]
  }
}
